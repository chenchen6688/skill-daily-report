# 工作日报配置示例
# 复制为 config.env 后按需修改

# ============ 外部输出（默认关闭，避免误发） ============
FEISHU_USER_ID=
FEISHU_WEBHOOK_URL=
ENABLE_FEISHU=false
ENABLE_GIT=false

# ============ 微信端策略（默认主动询问，不做主动推送） ============
WECHAT_QUERY_HINT_ENABLED=true
WECHAT_QUERY_COMMAND=日报

# ============ OpenClaw 路径（按需覆盖） ============
# OPENCLAW_HOME=~/.openclaw
# OPENCLAW_SESSIONS_DIR=~/.openclaw/agents/main/sessions

# ============ API 配置（可选） ============
# 不配置也能运行：会自动走 fallback 基础日报模式
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
#
# MINIMAX_API_KEY=
# MINIMAX_API_URL=https://api.minimaxi.com
# MINIMAX_MODEL=MiniMax-M2.5
