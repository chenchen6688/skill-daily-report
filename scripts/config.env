# MINIMAX_API_KEY=
# MINIMAX_API_URL=https://api.minimaxi.com
# MINIMAX_MODEL=MiniMax-M2.5
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
