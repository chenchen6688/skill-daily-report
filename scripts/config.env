# 工作日报配置
# 默认只生成本地 markdown，不做外部发送

# ============ 飞书推送（默认关闭） ============
FEISHU_USER_ID=
ENABLE_FEISHU=false

# ============ Git 推送（默认关闭） ============
ENABLE_GIT=false

# ============ API 配置（可选） ============
